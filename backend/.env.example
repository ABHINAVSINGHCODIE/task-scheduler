# ─────────────────────────────────────────────────────────────
# ReachInbox Full-Stack Email Job Scheduler - Environment Config
# ─────────────────────────────────────────────────────────────

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (supports 'postgres' or 'sqlite')
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=email_scheduler
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration (set REDIS_MOCK=false for real Redis)
REDIS_MOCK=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Slack OAuth 2.0 Integration & Notifications
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# Security & Concurrency Parameters
JWT_SECRET=super-secret-jwt-key-reachinbox-scheduler-production-2025
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50
